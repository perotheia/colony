// Theia fleet tailnet policy (colony / ground-station). Owner: tailnet admins.
// Tags are applied by pre-authorised auth keys minted by ground-station enroll/rig_enroll.py
// (TS_API_TOKEN): tag:fleet-gs for the ground station + provisioning server (panzer),
// tag:fleet-rig for every rig (BeagleBone AI-64, SK-TDA4VM, ...). Rigs never talk to each other.
{
	"tagOwners": {
		"tag:fleet-gs":  ["autogroup:admin"],
		"tag:fleet-rig": ["autogroup:admin"],
	},

	"grants": [
		// operators (tailnet members; group:fleet-ops later): their own devices, the GS (ssh, the Mender GUI/API +
		// the S3 plane on :443, gs-web), and ssh + ping to rigs. Nothing else on a rig: com gRPC (7700), DoIP
		// (13400), etcd are NOT reachable from an operator's laptop (hardening H9).
		{"src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"]},
		{"src": ["autogroup:member"], "dst": ["tag:fleet-gs"],  "ip": ["tcp:22", "tcp:443", "tcp:8088", "icmp:*"]},
		// + com gRPC (7700, trace 7710, log 7711): mutual TLS is mandatory there now (operator certificates
		// from the GS signer: ground-station tools/operator-cert.sh), so supervisor-gui / rtdb may reach a rig.
		{"src": ["autogroup:member"], "dst": ["tag:fleet-rig"], "ip": ["tcp:22", "tcp:7700", "tcp:7710-7711", "icmp:*"]},

		// the GS provisions (ssh) and observes (com gRPC) the rigs
		{"src": ["tag:fleet-gs"], "dst": ["tag:fleet-rig"], "ip": ["tcp:22", "tcp:7700", "tcp:7710-7711", "icmp:*"]},

		// a rig reaches the GS on TLS only (Mender + the S3 plane behind the gateway); never another rig.
		// MAVLink (udp:14550-14560) is NOT granted: no design uses it yet (hardening C5); add it with that design.
		{"src": ["tag:fleet-rig"], "dst": ["tag:fleet-gs"], "ip": ["tcp:443"]},
	],

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
	],

	"tests": [
		{"src": "tag:fleet-gs",  "accept": ["tag:fleet-rig:22", "tag:fleet-rig:7700"], "deny": ["tag:fleet-rig:13400", "tag:fleet-rig:2379"]},
		{"src": "tag:fleet-rig", "accept": ["tag:fleet-gs:443"], "deny": ["tag:fleet-gs:22", "tag:fleet-gs:9000", "tag:fleet-gs:8088", "tag:fleet-rig:22"]},
	],
}
